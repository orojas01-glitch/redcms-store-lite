      "secret": false,
      "permission": "store.settings.manage",
      "default": null
    },
    {
      "key": "checkout.pickup-enabled",
      "label": "Enable pickup checkout",
      "type": "boolean",
      "secret": false,
      "permission": "store.settings.manage",
      "default": null
    }
  ],
