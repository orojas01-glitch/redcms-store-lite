{
  "$schema": "https://red-sphere.com/schemas/addon-manifest-v1.json",
  "schemaVersion": 1,
  "id": "redcms.store-lite",
  "name": "RED-CMS Store Lite",
  "description": "Optional product catalog, cart, and order capability for one isolated RED-CMS client installation.",
  "version": "0.1.56",
  "type": "content-package",
  "compatibility": {
    "cms": ">=5.1 <6.0",
    "php": ">=8.2 <9.0"
  },
  "provides": {
    "components": [
      "redcms.store-lite/product",
      "redcms.store-lite/cart",
      "redcms.store-lite/subscription"
    ],
    "services": [
      "commerce.catalog",
      "commerce.cart",
      "commerce.orders",
      "commerce.subscriptions",
      "content.destination-preview.store-lite",
      "content.search-source.store-lite"
    ],
    "adminTools": [
      "redcms.store-lite/products",
      "redcms.store-lite/subscriptions",
      "redcms.store-lite/orders"
    ],
    "adapters": []
  },
  "dependencies": {
    "required": [],
    "optional": []
  },
  "permissions": [
    "store.products.manage",
    "store.orders.view",
    "store.orders.manage",
    "store.subscriptions.manage",
    "store.settings.manage"
  ],
  "componentEditors": [
    {
      "component": "redcms.store-lite/product",
      "label": "Product",
      "description": "Select the Store Lite product shown by this page component.",
      "icon": "products",
      "permissions": {
        "create": "store.products.manage",
        "view": "store.products.manage",
        "edit": "store.products.manage",
        "delete": "store.products.manage",
        "publish": "store.products.manage",
        "restore": "store.products.manage"
      },
      "fields": [
        {
          "key": "product-id",
          "label": "Product ID",
          "type": "text",
          "required": true,
          "help": "Enter the exact public Product ID from the Store Lite catalog.",
          "minLength": 1,
          "maxLength": 64
        }
      ]
    },
    {
      "component": "redcms.store-lite/cart",
      "label": "Cart",
      "description": "Show the current visitor's Store Lite cart.",
      "icon": "products",
      "permissions": {
        "create": "store.products.manage",
        "view": "store.products.manage",
        "edit": "store.products.manage",
        "delete": "store.products.manage",
        "publish": "store.products.manage",
        "restore": "store.products.manage"
      },
      "fields": [
        {
          "key": "cart-title",
          "label": "Cart title",
          "type": "text",
          "required": true,
          "help": "Heading shown above the current visitor's cart.",
          "minLength": 1,
          "maxLength": 160
        }
      ]
    },
    {
      "component": "redcms.store-lite/subscription",
      "label": "Subscription",
      "description": "Show one published Store Lite subscription offer and its intent button.",
      "icon": "products",
      "permissions": {
        "create": "store.subscriptions.manage",
        "view": "store.subscriptions.manage",
        "edit": "store.subscriptions.manage",
        "delete": "store.subscriptions.manage",
        "publish": "store.subscriptions.manage",
        "restore": "store.subscriptions.manage"
      },
      "fields": [
        {
          "key": "offer-id",
          "label": "Offer ID",
          "type": "text",
          "required": true,
          "help": "Enter the exact public Offer ID from Store Lite subscriptions.",
          "minLength": 1,
          "maxLength": 64
        }
      ]
    }
  ],
  "adminToolContracts": [
    {
      "tool": "redcms.store-lite/products",
      "label": "Products",
      "description": "Create or review products, destination status, and read-only provisioning readiness.",
      "icon": "products",
      "permission": "store.products.manage",
      "mode": "read-only"
    },
    {
      "tool": "redcms.store-lite/orders",
      "label": "Orders",
      "description": "Review current Store Lite order status.",
      "icon": "orders",
      "permission": "store.orders.view",
      "mode": "read-only"
    },
    {
      "tool": "redcms.store-lite/subscriptions",
      "label": "Subscriptions",
      "description": "Create or review monthly and yearly subscription offers.",
      "icon": "products",
      "permission": "store.subscriptions.manage",
      "mode": "read-only"
    }
  ],
  "adminToolFormContracts": [
    {
      "tool": "redcms.store-lite/products",
      "form": "redcms.store-lite/product-editor",
      "label": "Product details",
      "description": "Create or edit one Store Lite product and its variants.",
      "create": {
        "label": "Add product",
        "description": "Create one draft Store Lite product and its variants."
      },
      "permission": "store.products.manage",
      "method": "POST",
      "csrf": "required",
      "encoding": "application/json",
      "maxBodyBytes": 262144,
      "runtimeSettings": [
        "catalog.currency"
      ],
      "fields": [
        {
          "key": "id",
          "label": "Product ID",
          "type": "text",
          "required": true,
          "help": "Lowercase letters, digits, dots, dashes or underscores, starting with a letter (for example cafe-500g). Cannot be changed later.",
          "minLength": 1,
          "maxLength": 64
        },
        {
          "key": "type",
          "label": "Product type",
          "type": "select",
          "required": true,
          "options": [
            { "value": "simple", "label": "Simple product" },
            { "value": "variable", "label": "Product with variants" }
          ]
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "required": true,
          "minLength": 1,
          "maxLength": 160
        },
        {
          "key": "summary",
          "label": "Summary",
          "type": "textarea",
          "required": false,
          "maxLength": 1000
        },
        {
          "key": "currency",
          "label": "Installation currency",
          "type": "text",
          "required": true,
          "help": "The store catalog currency in three capital letters, for example COP or USD. It must match the Catalog currency setting.",
          "minLength": 3,
          "maxLength": 3
        },
        {
          "key": "state",
          "label": "State",
          "type": "select",
          "required": true,
          "options": [
            { "value": "draft", "label": "Draft" },
            { "value": "published", "label": "Published" },
            { "value": "archived", "label": "Archived" }
          ]
        },
        {
          "key": "availability",
          "label": "Availability",
          "type": "select",
          "required": true,
          "options": [
            { "value": "available", "label": "Available" },
            { "value": "unavailable", "label": "Unavailable" }
          ]
        },
        {
          "key": "image-reference",
          "label": "Image reference",
          "type": "media-reference",
          "required": false,
          "maxLength": 70
        },
        {
          "key": "sku",
          "label": "SKU (required for simple products)",
          "type": "text",
          "required": false,
          "help": "UPPERCASE letters, digits, dots, dashes or underscores (for example CAFE-500G). Leave empty for a product with variants.",
          "maxLength": 64
        },
        {
          "key": "price-minor",
          "label": "Price in minor currency units (required for simple products)",
          "type": "integer",
          "required": false,
          "help": "Price x 100: COP 10.000 is 1000000, USD 12.50 is 1250. Leave empty for a product with variants.",
          "minimum": 0,
          "maximum": 999999999
        },
        {
          "key": "stock",
          "label": "Stock",
          "type": "integer",
          "required": false,
          "minimum": 0,
          "maximum": 1000000000
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "required": false,
          "itemLabel": "Option",
          "minItems": 0,
          "maxItems": 3,
          "fields": [
            {
              "key": "key",
              "label": "Option key",
              "type": "text",
              "required": true,
              "minLength": 1,
              "maxLength": 64
            },
            {
              "key": "label",
              "label": "Option label",
              "type": "text",
              "required": true,
              "minLength": 1,
              "maxLength": 160
            },
            {
              "key": "values",
              "label": "Option values",
              "type": "collection",
              "required": true,
              "itemLabel": "Option value",
              "minItems": 1,
              "maxItems": 16,
              "fields": [
                {
                  "key": "id",
                  "label": "Value ID",
                  "type": "text",
                  "required": true,
                  "minLength": 1,
                  "maxLength": 64
                },
                {
                  "key": "label",
                  "label": "Value label",
                  "type": "text",
                  "required": true,
                  "minLength": 1,
                  "maxLength": 160
                }
              ]
            }
          ]
        },
        {
          "key": "variants",
          "label": "Variants",
          "type": "collection",
          "required": false,
          "itemLabel": "Variant",
          "minItems": 0,
          "maxItems": 128,
          "fields": [
            {
              "key": "id",
              "label": "Variant ID",
              "type": "text",
              "required": true,
              "minLength": 1,
              "maxLength": 64
            },
            {
              "key": "sku",
              "label": "SKU",
              "type": "text",
              "required": true,
              "help": "UPPERCASE letters, digits, dots, dashes or underscores (for example CAFE-500G-S).",
              "minLength": 1,
              "maxLength": 64
            },
            {
              "key": "options",
              "label": "Option selections",
              "type": "collection",
              "required": true,
              "itemLabel": "Option selection",
              "minItems": 1,
              "maxItems": 3,
              "fields": [
                {
                  "key": "key",
                  "label": "Option key",
                  "type": "text",
                  "required": true,
                  "minLength": 1,
                  "maxLength": 64
                },
                {
                  "key": "value",
                  "label": "Value ID",
                  "type": "text",
                  "required": true,
                  "minLength": 1,
                  "maxLength": 64
                }
              ]
            },
            {
              "key": "price-minor",
              "label": "Price in minor currency units",
              "type": "integer",
              "required": true,
              "help": "Price x 100: COP 10.000 is 1000000, USD 12.50 is 1250.",
              "minimum": 0,
              "maximum": 999999999
            },
            {
              "key": "availability",
              "label": "Availability",
              "type": "select",
              "required": true,
              "options": [
                { "value": "available", "label": "Available" },
                { "value": "unavailable", "label": "Unavailable" }
              ]
            },
            {
              "key": "stock",
              "label": "Stock",
              "type": "integer",
              "required": false,
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "key": "image-reference",
              "label": "Image reference",
              "type": "media-reference",
              "required": false,
              "maxLength": 70
            }
          ]
        }
      ]
    },
    {
      "tool": "redcms.store-lite/subscriptions",
      "form": "redcms.store-lite/subscription-offer-editor",
      "label": "Subscription offer",
      "description": "Create or edit one monthly or yearly subscription offer.",
      "create": {"label":"Add subscription offer","description":"Create one draft subscription offer."},
      "permission": "store.subscriptions.manage",
      "method": "POST",
      "csrf": "required",
      "encoding": "application/json",
      "maxBodyBytes": 16384,
      "runtimeSettings": ["catalog.currency"],
      "fields": [
        {"key":"id","label":"Offer ID","type":"text","required":true,"minLength":1,"maxLength":64},
        {"key":"product-id","label":"Product ID","type":"text","required":true,"minLength":1,"maxLength":64},
        {"key":"variant-id","label":"Variant ID","type":"text","required":false,"maxLength":64},
        {"key":"title","label":"Title","type":"text","required":true,"minLength":1,"maxLength":160},
        {"key":"summary","label":"Summary","type":"textarea","required":false,"maxLength":1000},
        {"key":"currency","label":"Installation currency","type":"text","required":true,"minLength":3,"maxLength":3},
        {"key":"price-minor","label":"Recurring price in minor currency units","type":"integer","required":true,"minimum":0,"maximum":999999999},
        {"key":"billing-period","label":"Billing period","type":"select","required":true,"options":[{"value":"monthly","label":"Monthly"},{"value":"yearly","label":"Yearly"}]},
        {"key":"state","label":"State","type":"select","required":true,"options":[{"value":"draft","label":"Draft"},{"value":"published","label":"Published"},{"value":"archived","label":"Archived"}]},
        {"key":"availability","label":"Availability","type":"select","required":true,"options":[{"value":"available","label":"Available"},{"value":"unavailable","label":"Unavailable"}]},
        {"key":"button-label","label":"Button label","type":"text","required":true,"minLength":1,"maxLength":80}
      ]
    }
  ],
  "settings": [
    {
      "key": "catalog.currency",
      "label": "Catalog currency",
      "type": "text",
      "secret": false,
      "permission": "store.settings.manage",
      "default": null
    },
    {
      "key": "checkout.delivery-enabled",
      "label": "Enable delivery checkout",
      "type": "boolean",
      "secret": false,
      "permission": "store.settings.manage",
      "default": null
    },
    {
      "key": "checkout.delivery-fee-minor",
      "label": "Delivery fee in minor currency units",
      "type": "integer",
      "secret": false,
      "permission": "store.settings.manage",
      "default": null
    },
    {
      "key": "checkout.pay-on-receipt-enabled",
      "label": "Offer pay on receipt (turn on at least one payment method)",
      "type": "boolean",
      "secret": false,
      "permission": "store.settings.manage",
      "default": null
    },
    {
      "key": "checkout.pickup-enabled",
      "label": "Enable pickup checkout",
      "type": "boolean",
      "secret": false,
      "permission": "store.settings.manage",
      "default": null
    },
    {
      "key": "checkout.wompi-enabled",
      "label": "Offer Wompi Web Checkout (COP only; turn on at least one payment method)",
      "type": "boolean",
      "secret": false,
      "permission": "store.settings.manage",
      "default": null
    },
    {
      "key": "checkout.wompi-colombia-only",
      "label": "Show Wompi only to visitors detected in Colombia",
      "type": "boolean",
      "secret": false,
      "permission": "store.settings.manage",
      "default": null
    }
  ],
