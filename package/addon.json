          "type": "positive-integer",
          "required": true,
          "minimum": 1,
          "maximum": 100
        },
        {
          "key": "variant",
          "type": "identifier",
          "required": false,
          "minLength": 1,
          "maxLength": 64
        }
      ],
      "subject": "anonymous",
      "idempotency": "core-issued-key",
      "privacy": "no-store",
      "rateLimit": "required",
