{
  "$schema": "https://red-sphere.com/schemas/addon-manifest-v1.json",
  "schemaVersion": 1,
  "id": "redcms.store-lite",
  "name": "RED-CMS Store Lite",
  "description": "Optional product catalog, cart, and order capability for one isolated RED-CMS client installation.",
  "version": "0.1.13",
  "type": "content-package",
  "compatibility": {
    "cms": ">=5.1 <6.0",
    "php": ">=8.2 <9.0"
  },
  "provides": {
    "components": [
      "redcms.store-lite/product"
    ],
    "services": [
      "commerce.catalog",
      "commerce.cart",
      "commerce.orders"
    ],
    "adminTools": [
      "redcms.store-lite/products",
      "redcms.store-lite/orders"
    ],
    "adapters": []
  },
  "dependencies": {
    "required": [],
    "optional": []
  },
  "permissions": [
    "store.products.manage",
    "store.orders.view",
    "store.orders.manage",
    "store.settings.manage"
  ],
  "componentEditors": [
    {
      "component": "redcms.store-lite/product",
      "label": "Product",
      "description": "Select the Store Lite product shown by this page component.",
      "icon": "products",
      "permissions": {
        "create": "store.products.manage",
        "view": "store.products.manage",
        "edit": "store.products.manage",
        "delete": "store.products.manage",
        "publish": "store.products.manage",
        "restore": "store.products.manage"
      },
      "fields": [
        {
          "key": "product-id",
          "label": "Product ID",
          "type": "text",
          "required": true,
          "help": "Enter the exact public Product ID from the Store Lite catalog.",
          "minLength": 1,
          "maxLength": 64
        }
      ]
    }
  ],
  "adminToolContracts": [
    {
      "tool": "redcms.store-lite/products",
      "label": "Products",
      "description": "Create or review the current Store Lite product catalog.",
      "icon": "products",
      "permission": "store.products.manage",
      "mode": "read-only"
    },
    {
      "tool": "redcms.store-lite/orders",
      "label": "Orders",
      "description": "Review current Store Lite order status.",
      "icon": "orders",
      "permission": "store.orders.view",
      "mode": "read-only"
    }
  ],
  "adminToolFormContracts": [
    {
      "tool": "redcms.store-lite/products",
      "form": "redcms.store-lite/product-editor",
      "label": "Product details",
      "description": "Create or edit one Store Lite product and its variants.",
      "create": {
        "label": "Add product",
        "description": "Create one draft Store Lite product and its variants."
      },
      "permission": "store.products.manage",
      "method": "POST",
      "csrf": "required",
      "encoding": "application/json",
      "maxBodyBytes": 262144,
      "runtimeSettings": [
        "catalog.currency"
      ],
      "fields": [
        {
          "key": "id",
          "label": "Product ID",
          "type": "text",
          "required": true,
          "minLength": 1,
          "maxLength": 64
        },
        {
          "key": "type",
          "label": "Product type",
          "type": "select",
          "required": true,
          "options": [
            { "value": "simple", "label": "Simple product" },
            { "value": "variable", "label": "Product with variants" }
          ]
        },
        {
          "key": "title",
          "label": "Title",
          "type": "text",
          "required": true,
          "minLength": 1,
          "maxLength": 160
        },
        {
          "key": "summary",
          "label": "Summary",
          "type": "textarea",
          "required": false,
          "maxLength": 1000
        },
        {
          "key": "currency",
          "label": "Installation currency",
          "type": "text",
          "required": true,
          "minLength": 3,
          "maxLength": 3
        },
        {
          "key": "state",
          "label": "State",
          "type": "select",
          "required": true,
          "options": [
            { "value": "draft", "label": "Draft" },
            { "value": "published", "label": "Published" },
            { "value": "archived", "label": "Archived" }
          ]
        },
        {
          "key": "availability",
          "label": "Availability",
          "type": "select",
          "required": true,
          "options": [
            { "value": "available", "label": "Available" },
            { "value": "unavailable", "label": "Unavailable" }
          ]
        },
        {
          "key": "image-reference",
          "label": "Image reference",
          "type": "media-reference",
          "required": false,
          "maxLength": 70
        },
        {
          "key": "sku",
          "label": "SKU",
          "type": "text",
          "required": false,
          "maxLength": 64
        },
        {
          "key": "price-minor",
          "label": "Price in minor currency units",
          "type": "integer",
          "required": false,
          "minimum": 0,
          "maximum": 999999999
        },
        {
          "key": "stock",
          "label": "Stock",
          "type": "integer",
          "required": false,
          "minimum": 0,
          "maximum": 1000000000
        },
        {
          "key": "options",
          "label": "Options",
          "type": "collection",
          "required": false,
          "itemLabel": "Option",
          "minItems": 0,
          "maxItems": 3,
          "fields": [
            {
              "key": "key",
              "label": "Option key",
              "type": "text",
              "required": true,
              "minLength": 1,
              "maxLength": 64
            },
            {
              "key": "label",
              "label": "Option label",
              "type": "text",
              "required": true,
              "minLength": 1,
              "maxLength": 160
            },
            {
              "key": "values",
              "label": "Option values",
              "type": "collection",
              "required": true,
              "itemLabel": "Option value",
              "minItems": 1,
              "maxItems": 16,
              "fields": [
                {
                  "key": "id",
                  "label": "Value ID",
                  "type": "text",
                  "required": true,
                  "minLength": 1,
                  "maxLength": 64
                },
                {
                  "key": "label",
                  "label": "Value label",
                  "type": "text",
                  "required": true,
                  "minLength": 1,
                  "maxLength": 160
                }
              ]
            }
          ]
        },
        {
          "key": "variants",
          "label": "Variants",
          "type": "collection",
          "required": false,
          "itemLabel": "Variant",
          "minItems": 0,
          "maxItems": 128,
          "fields": [
            {
              "key": "id",
              "label": "Variant ID",
              "type": "text",
              "required": true,
              "minLength": 1,
              "maxLength": 64
            },
            {
              "key": "sku",
              "label": "SKU",
              "type": "text",
              "required": true,
              "minLength": 1,
              "maxLength": 64
            },
            {
              "key": "options",
              "label": "Option selections",
              "type": "collection",
              "required": true,
              "itemLabel": "Option selection",
              "minItems": 1,
              "maxItems": 3,
              "fields": [
                {
                  "key": "key",
                  "label": "Option key",
                  "type": "text",
                  "required": true,
                  "minLength": 1,
                  "maxLength": 64
                },
                {
                  "key": "value",
                  "label": "Value ID",
                  "type": "text",
                  "required": true,
                  "minLength": 1,
                  "maxLength": 64
                }
              ]
            },
            {
              "key": "price-minor",
              "label": "Price in minor currency units",
              "type": "integer",
              "required": true,
              "minimum": 0,
              "maximum": 999999999
            },
            {
              "key": "availability",
              "label": "Availability",
              "type": "select",
              "required": true,
              "options": [
                { "value": "available", "label": "Available" },
                { "value": "unavailable", "label": "Unavailable" }
              ]
            },
            {
              "key": "stock",
              "label": "Stock",
              "type": "integer",
              "required": false,
              "minimum": 0,
              "maximum": 1000000000
            },
            {
              "key": "image-reference",
              "label": "Image reference",
              "type": "media-reference",
              "required": false,
              "maxLength": 70
            }
          ]
        }
      ]
    }
  ],
  "settings": [
    {
      "key": "catalog.currency",
      "label": "Catalog currency",
      "type": "text",
      "secret": false,
      "permission": "store.settings.manage",
      "default": null
    }
  ],
  "migrations": [
