  "routes": [
    {
      "id": "redcms.store-lite/cart-intent",
      "scope": "public",
      "path": "/addons/redcms/store-lite/cart-intent",
      "methods": [
        "POST"
      ],
      "authentication": "public",
      "csrf": "required"
    },
    {
      "id": "redcms.store-lite/cart-line-quantity",
      "scope": "public",
      "path": "/addons/redcms/store-lite/cart-line-quantity",
      "methods": [
